# upstream-streaming-server — local environment example.
#
# Copy to `.env` for local overrides. `.env` is gitignored. No real secrets
# belong in this file — production secrets live in your deployment platform.

# --- Ports (must match docker-compose.yml port mappings) ---
SRT_PORT=8890
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_API_PORT=9997

# --- M9.1/M9.2: resource fences + admin/metrics port binds (optional) ---
# All four interpolate into docker-compose.yml with dev-laptop-safe
# defaults; an unset host env keeps the values shown here. See
# docs/design/03-isolation-and-blast-radius.md §3 and
# docs/design/05-security-hardening.md §3.
#
#   UPSTREAM_MEDIAMTX_CPUS          CPU ceiling (NOT a reservation) for the
#                                   mediamtx container. Dev default 2.0;
#                                   PROD: 6.0 on the 8-vCPU ingest node.
#   UPSTREAM_MEDIAMTX_MEM_LIMIT     Memory limit. Dev default 2g;
#                                   PROD: 12g on the 16 GB ingest node.
#   UPSTREAM_MEDIAMTX_API_BIND      Host interface for the MediaMTX API
#                                   port 9997. Default 127.0.0.1 (not
#                                   reachable off-box). PROD: 0.0.0.0 +
#                                   scripts/firewall-restrict-readports.sh
#                                   allow-listing the api-server egress IP
#                                   only (the api-server provisions paths
#                                   over this port).
#   UPSTREAM_MEDIAMTX_METRICS_BIND  Host interface for the MediaMTX
#                                   Prometheus metrics port (M9.2),
#                                   host-published as 19998 (container
#                                   9998) per the docs/design/05 §3 port
#                                   table; local scrape:
#                                   curl 127.0.0.1:19998/metrics.
#                                   Default 127.0.0.1. PROD: 0.0.0.0 +
#                                   scripts/firewall-restrict-readports.sh
#                                   allow-listing the monitoring box IP
#                                   only (MONITORING_IP env; the metrics
#                                   port stays blocked when it is unset).
UPSTREAM_MEDIAMTX_CPUS=2.0
UPSTREAM_MEDIAMTX_MEM_LIMIT=2g
UPSTREAM_MEDIAMTX_API_BIND=127.0.0.1
UPSTREAM_MEDIAMTX_METRICS_BIND=127.0.0.1

# --- Smoke-test defaults ---
SRT_HOST=localhost
STREAM_NAME=test
WIDTH=1280
HEIGHT=720
FPS=30
BITRATE_KBPS=3000

# --- API-issued SRT URL (Milestone 2) ---
# Do NOT put a real URL here. Real API-issued URLs contain a session JWT
# inside `streamid=publish:<jwt>` and must never be committed. Use the
# shell instead:
#   export API_SRT_URL='srt://...'
#   ./scripts/publish_api_srt_url.sh
# Documented latency the API will return for the default `balanced` mode.
# This server does not read it; the API bakes it into the URL.
SRT_LATENCY_MS=200

# --- M4: lifecycle webhooks back to upstream-api-server ---
# Required when the `runOnReady` / `runOnNotReady` hooks are enabled in
# `mediamtx/mediamtx.yml` (they are, as of M4). Both env vars MUST be set
# on the host shell or in `.env` — `docker-compose.yml` interpolates them
# at compose-up time and the hook scripts fail loudly if either is empty.
#
# `UPSTREAM_MEDIAMTX_WEBHOOK_SECRET` must MATCH the value the api-server
# resolves for `Settings.mediamtx_webhook_secret` (env
# `UPSTREAM_MEDIAMTX_WEBHOOK_SECRET` on the api-server too). Generate
# with `openssl rand -hex 32` and store in your deployment secrets manager.
# As of M4.1 the same value is also embedded in the URL path segment of
# the authHTTP deny-gate (see `docs/stream-auth.md`) — the api-server
# constant-time compares both call paths against this one secret.
#
# `UPSTREAM_API_BASE_URL` is the publicly reachable origin of the api-server
# (`https://api.upstreamcv.com` for prod). Local dev pointing at a host-side
# api-server: `http://host.docker.internal:8000`.
#
# Do NOT commit real values — `.env` is gitignored.
UPSTREAM_MEDIAMTX_WEBHOOK_SECRET=replace-me-must-match-api-server
UPSTREAM_API_BASE_URL=https://api.upstreamcv.com

# --- M5.2: media validation enforcement (optional; default OFF) ---
# Controls what the `runOnReady` hook does when the comparator returns
# passed=false:
#   0 = M5.1 report-only mode. A passed=false stream_validations row is
#       recorded; the stream is NOT killed or deprovisioned. (default)
#   1 = M5.2 enforcement mode. A failed validation POSTs
#       /v1/ingest/validation-failed; the API marks the session failed,
#       mirrors cameras.status=error, and may deprovision the MediaMTX
#       path. Accepted truthy values: 1, true, TRUE, yes, YES.
# Leave at 0 until M5.2 has been live-verified (see docs/stream-validation.md).
UPSTREAM_VALIDATION_ENFORCE=0

# --- M6.1A: local latest-frame JPEG snapshotter (optional; LOCAL ONLY) ---
# When the `runOnReady` hook's media validation PASSES, on_ready.sh spawns
# `scripts/hooks/snapshotter.sh` fully detached. It grabs ONE frame off the
# local RTSP re-stream every UPSTREAM_SNAPSHOT_INTERVAL_SECONDS and atomically
# writes `${UPSTREAM_SNAPSHOT_DIR}/<MTX_PATH>.jpg` (host: ./snapshots, which
# is gitignored). It self-exits after UPSTREAM_SNAPSHOT_MAX_FAILURES
# consecutive failures — that is how it stops when the publisher leaves.
#
# LOCAL ONLY in M6.1A: nothing is uploaded and no API/webhook call is made.
# The webhook-authed upload endpoint POST /v1/ingest/snapshots is deferred
# to M6.2 (tracked as FU-9 in docs/follow-ups.md).
#
#   UPSTREAM_SNAPSHOTTER_ENABLED         1 (default) on; 0/false/no disables.
#   UPSTREAM_SNAPSHOT_INTERVAL_SECONDS   seconds between grabs (default 10).
#   UPSTREAM_SNAPSHOT_DIR                in-container output dir (default
#                                        /snapshots; must match the
#                                        docker-compose mount target).
#   UPSTREAM_SNAPSHOT_JPEG_QUALITY       ffmpeg -q:v, 2=best..31=worst (def 3).
#   UPSTREAM_SNAPSHOT_MAX_FAILURES       consecutive grab failures before the
#                                        snapshotter self-exits (default 6).
UPSTREAM_SNAPSHOTTER_ENABLED=1
UPSTREAM_SNAPSHOT_INTERVAL_SECONDS=10
UPSTREAM_SNAPSHOT_DIR=/snapshots
UPSTREAM_SNAPSHOT_JPEG_QUALITY=3
UPSTREAM_SNAPSHOT_MAX_FAILURES=6

# --- M6.1B: automatic latest-frame upload (optional; default OFF) ---
# When 1, scripts/hooks/snapshotter.sh best-effort uploads each
# just-published JPEG to the api-server's webhook-secret-authed
# `POST /v1/ingest/snapshots` (the M6.2-delta endpoint — it must be
# DEPLOYED on the api-server before enabling this, or every upload 404s).
# It reuses UPSTREAM_API_BASE_URL + UPSTREAM_MEDIAMTX_WEBHOOK_SECRET (set
# above) and the session_id resolved by on_ready.sh; no agent token.
#
# Best-effort by contract: an upload failure only logs and is swallowed —
# it never aborts the snapshotter loop, never changes the self-bounding
# exit, and never touches the M4/M5 lifecycle. After
# UPSTREAM_SNAPSHOT_UPLOAD_MAX_FAILURES consecutive upload failures the
# snapshotter stops *uploading* for the rest of its life (one log line)
# but local extraction keeps running.
#
# The storage bucket stays PRIVATE: the dashboard renders frames via
# signed URLs from `GET /v1/cameras/{id}/latest-frame`, not by reading the
# bucket directly. Leave at 0 until M6.1B has been live-verified.
#
#   UPSTREAM_SNAPSHOT_UPLOAD_ENABLED          0 (default) off; 1/true/yes on.
#   UPSTREAM_SNAPSHOT_UPLOAD_MAX_FAILURES     consecutive upload failures
#                                             before upload self-disables
#                                             (default 6; grab cap is separate).
#   UPSTREAM_SNAPSHOT_UPLOAD_TIMEOUT_SECONDS  per-upload curl --max-time
#                                             (default 8; keep < interval).
#   UPSTREAM_SNAPSHOT_WIDTH                    fallback width when on_ready.sh
#                                             could not pass observed (def 1280).
#   UPSTREAM_SNAPSHOT_HEIGHT                   fallback height (default 720).
#   UPSTREAM_SNAPSHOT_UPLOAD_EVERY_N_FRAMES   upload every Nth published frame
#                                             (default 1 = every frame).
UPSTREAM_SNAPSHOT_UPLOAD_ENABLED=0
UPSTREAM_SNAPSHOT_UPLOAD_MAX_FAILURES=6
UPSTREAM_SNAPSHOT_UPLOAD_TIMEOUT_SECONDS=8
UPSTREAM_SNAPSHOT_WIDTH=1280
UPSTREAM_SNAPSHOT_HEIGHT=720
UPSTREAM_SNAPSHOT_UPLOAD_EVERY_N_FRAMES=1

# --- Perception fan-out sidecar (high-rate detection overlays) ---
# The `perception-fanout` container relays processor perception snapshots
# to browser WebSocket subscribers at 10–15 Hz, bypassing the DB. Wire
# contract + deploy checklist: docs/perception-fanout.md.
#
# Both secrets are REQUIRED — the container refuses to start when either
# is empty. Generate with `openssl rand -hex 32`; do NOT commit real
# values (`.env` is gitignored; the placeholders below only exist so
# `docker compose config` validates in CI).
#
#   UPSTREAM_FANOUT_PUBLISH_SECRET    Shared secret the external processor
#                                     sends as X-Upstream-Webhook-Secret on
#                                     its publish connection. Dedicated
#                                     secret — deliberately NOT the
#                                     api-server's processor webhook secret
#                                     (don't widen that secret's blast
#                                     radius); ops MAY set them equal.
#   UPSTREAM_FANOUT_TOKEN_SECRET      HMAC secret for subscriber tokens.
#                                     Must MATCH the api-server's
#                                     `fanout_token_secret` (env
#                                     UPSTREAM_FANOUT_TOKEN_SECRET there
#                                     too) — the api-server mints, this
#                                     sidecar verifies.
#   UPSTREAM_FANOUT_BIND              Host interface for host port 18990
#                                     (container 8990). Default 127.0.0.1.
#                                     PROD: 0.0.0.0 behind the deployment
#                                     Caddy (wss://…/perception/* →
#                                     127.0.0.1:18990) or firewalled via
#                                     scripts/firewall-restrict-readports.sh.
#   UPSTREAM_FANOUT_MAX_MESSAGE_BYTES Max publish frame size (default 262144).
#   UPSTREAM_FANOUT_MAX_SUBSCRIBERS   Per-instance subscriber cap (default
#                                     100); excess connects close 1013.
#   UPSTREAM_FANOUT_CPUS              CPU ceiling (default 0.5).
#   UPSTREAM_FANOUT_MEM_LIMIT         Memory limit (default 256m).
UPSTREAM_FANOUT_PUBLISH_SECRET=replace-me-processor-publish-secret
UPSTREAM_FANOUT_TOKEN_SECRET=replace-me-must-match-api-server
UPSTREAM_FANOUT_BIND=127.0.0.1
UPSTREAM_FANOUT_MAX_MESSAGE_BYTES=262144
UPSTREAM_FANOUT_MAX_SUBSCRIBERS=100
UPSTREAM_FANOUT_CPUS=0.5
UPSTREAM_FANOUT_MEM_LIMIT=256m
