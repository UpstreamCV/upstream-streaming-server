# upstream-streaming-server — local environment example.
#
# Copy to `.env` for local overrides. `.env` is gitignored. No real secrets
# belong in this file — production secrets live in your deployment platform.

# --- Ports (must match docker-compose.yml port mappings) ---
SRT_PORT=8890
RTSP_PORT=8554
WEBRTC_PORT=8889
WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_API_PORT=9997

# --- Smoke-test defaults ---
SRT_HOST=localhost
STREAM_NAME=test
WIDTH=1280
HEIGHT=720
FPS=30
BITRATE_KBPS=3000

# --- Future (NOT used in Milestone 1) ---
# Shared secret used to authenticate webhook calls from the streaming server
# to upstream-api-server (`POST /v1/ingest/...`). Set in M4, do not commit.
# UPSTREAM_MEDIAMTX_WEBHOOK_SECRET=
# Base URL for upstream-api-server. Set in M4.
# UPSTREAM_API_BASE_URL=
